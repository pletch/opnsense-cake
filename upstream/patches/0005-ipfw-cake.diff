+.Pp
+.Dl "dnctl pipe 1 config bw 95mbits/s"
+.Dl "dnctl sched 1 config pipe 1 type cake diffserv4"
+.Dl "dnctl queue 1 config sched 1"
+.Dl "ipfw add 100 queue 1 ip from any to any out xmit em0"
+.Pp
