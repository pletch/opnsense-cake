diff --git a/sys/netpfil/ipfw/dn_sched.h b/sys/netpfil/ipfw/dn_sched.h
index ade15c6db..4e458c166 100644
--- a/sys/netpfil/ipfw/dn_sched.h
+++ b/sys/netpfil/ipfw/dn_sched.h
@@ -142,6 +142,14 @@ struct dn_alg {
 	/* run-time fields */
 	int ref_count;      /* XXX number of instances in the system */
 	CK_LIST_ENTRY(dn_alg) next; /* Next scheduler in the list */
+
+	/*
+	 * wire_len	optional: the bytes to charge against the link rate
+	 *	for a packet the scheduler has just dequeued, where they
+	 *	differ from the packet's length (link-layer overhead
+	 *	compensation). Called with the scheduler lock held.
+	 */
+	uint32_t (*wire_len)(struct dn_sch_inst *, struct mbuf *);
 };
 
 /* MSVC does not support initializers so we need this ugly macro */
diff --git a/sys/netpfil/ipfw/ip_dn_io.c b/sys/netpfil/ipfw/ip_dn_io.c
index 1d97899df..46bc959f6 100644
--- a/sys/netpfil/ipfw/ip_dn_io.c
+++ b/sys/netpfil/ipfw/ip_dn_io.c
@@ -615,7 +615,9 @@ serve_sched(struct mq *q, struct dn_sch_inst *si, uint64_t now)
 
 		done++;
 		len_scaled = (bw == 0) ? 0 : hz *
-			(m->m_pkthdr.len * 8 + extra_bits(m, s));
+			((uint64_t)(s->fp->wire_len != NULL ?
+			s->fp->wire_len(si, m) : m->m_pkthdr.len) * 8 +
+			extra_bits(m, s));
 		si->credit -= len_scaled;
 		/* Move packet in the delay line */
 		dn_tag_get(m)->output_time = V_dn_cfg.curr_time + s->link.delay ;
