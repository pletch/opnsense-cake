diff --git a/sys/netpfil/ipfw/ip_dummynet.c b/sys/netpfil/ipfw/ip_dummynet.c
index a4f0452..5c2e8d3 100644
--- a/sys/netpfil/ipfw/ip_dummynet.c
+++ b/sys/netpfil/ipfw/ip_dummynet.c
@@ -2406,6 +2406,42 @@ drain_scheduler_sch_cb(void *_s, void *arg)
 	return 0;
 }
 
+/* Callback called on scheduler instance to print its statistics */
+static int
+stats_si_cb(void *_si, void *arg)
+{
+	struct dn_sch_inst *si = _si;
+
+	si->sched->fp->stats(si, arg);
+	return (0);
+}
+
+/* Callback called on scheduler to print its instances' statistics */
+static int
+stats_sch_cb(void *_s, void *arg)
+{
+	struct dn_schk *s = _s;
+
+	if (s->fp == NULL || (s->fp->flags & DN_STATS) == 0)
+		return (0);
+	if (s->sch.flags & DN_HAVE_MASK)
+		dn_ht_scan(s->siht, stats_si_cb, arg);
+	else if (s->siht != NULL)
+		stats_si_cb(s->siht, arg);
+	return (0);
+}
+
+/*
+ * The statistics of the schedulers that have a stats method, for the
+ * sched_stats sysctl.
+ */
+void
+dn_sched_stats(struct sbuf *sb)
+{
+	DN_BH_LOCK_ASSERT();
+	dn_ht_scan(V_dn_cfg.schedhash, stats_sch_cb, sb);
+}
+
 /* Called every tick, try to delete a 'bucket' of scheduler */
 void
 dn_drain_scheduler(void)
