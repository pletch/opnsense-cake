+/* the pipes' clock, now: us of uptime, never going back */
+static uint64_t
+dn_now_us(void)
+{
+	uint64_t t = sbttous(sbinuptime());
+
+	DN_BH_LOCK_ASSERT();
+	if (t > V_dn_cfg.now_us)
+		V_dn_cfg.now_us = t;
+	return (V_dn_cfg.now_us);
+}
+
+/* an event's time as its heap key: below the tick, on the release grid */
+static uint64_t
+dn_key(uint64_t t)
+{
+	uint64_t r = (uint64_t)dn_release();
+
+	return (r < (uint64_t)tick ? (t + r - 1) / r * r : t);
+}
+
+/* wake for the first event, if it comes before the tick */
+static void
+dn_arm_top(void)
+{
+	DN_BH_LOCK_ASSERT();
+	if (V_dn_cfg.evheap.elements > 0)
+		dn_fine_arm(HEAP_TOP(&V_dn_cfg.evheap)->key);
+}
