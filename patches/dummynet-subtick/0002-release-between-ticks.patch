+/*
+ * Sub-tick release (opnsense-cake, SUBTICK.md). A pipe's times are in
+ * microseconds of uptime rather than ticks: its scheduler instances'
+ * times, its packets' output times, the event heap's keys and its delay,
+ * and its credit is in bits * DN_CREDIT_HZ. curr_time stays in ticks for
+ * the AQMs and RED. While dn_release() is below the tick, a callout
+ * (dn_fine_arm()) wakes dummynet when the first event is due, on a grid
+ * of dn_release() us, besides the tick.
+ */
+#define DN_CREDIT_HZ	1000000
+#define DN_RELEASE_NS	((uint64_t)dn_release() * 1000)
+extern int dn_release_us;	/* net.inet.ip.dummynet.release_us, 0: the tick */
+
+/* the longest a due packet waits for release, in us */
+static __inline int
+dn_release(void)
+{
+	return (dn_release_us > 0 && dn_release_us < tick ? dn_release_us : tick);
+}
+
