  * configuration and data for a dummynet instance
  *
@@ -136,6 +156,7 @@ struct dn_parms {
 
 	/* ticks and other stuff */
 	uint64_t	curr_time;
+	uint64_t	now_us;		/* the pipes' clock, us of uptime */
 	/* flowsets and schedulers are in hash tables, with 'hash_size'
 	 * buckets. fshash is looked up at every packet arrival
 	 * so better be generous if we expect many entries.
@@ -409,7 +430,10 @@ int dummynet_io(struct mbuf **, struct ip_fw_args *);
 void dummynet_sched_lock(void);
 void dummynet_sched_unlock(void);
 void dummynet_task(void *context, int pending);
+void dummynet_fine_task(void *context, int pending);
 void dn_reschedule(void);
+void dn_fine_arm(uint64_t);
+extern uint64_t dn_fine_fired;
 struct dn_pkt_tag * dn_tag_get(struct mbuf *m);
 
 struct dn_queue *ipdn_q_find(struct dn_fsk *, struct dn_sch_inst *,
diff --git a/sys/netpfil/ipfw/ip_dummynet.c b/sys/netpfil/ipfw/ip_dummynet.c
index 61442c61775..9d303876ac0 100644
--- a/sys/netpfil/ipfw/ip_dummynet.c
+++ b/sys/netpfil/ipfw/ip_dummynet.c
@@ -92,6 +92,18 @@ static int dn_gone;
 static struct task	dn_task;
 static struct taskqueue	*dn_tq = NULL;
 
+/*
+ * Releases between ticks (SUBTICK.md): dn_fine fires at the first event
+ * due before the next tick, at dn_fine_at us of uptime, and queues
+ * dn_fine_task. dn_fine_mtx guards dn_fine_at; it is a spin lock, as
+ * dn_fine runs directly from the timer interrupt.
+ */
+static struct callout	dn_fine;
+static struct mtx	dn_fine_mtx;
+static struct task	dn_fine_task;
+static uint64_t		dn_fine_at;	/* 0: not armed */
+uint64_t		dn_fine_fired;	/* what the last wakeup was for */
+
 /* global scheduler list */
 struct mtx		sched_mtx;
 CK_LIST_HEAD(, dn_alg)	schedlist;
@@ -107,6 +119,39 @@ dummynet(void *arg)
 	taskqueue_enqueue(dn_tq, &dn_task);
 }
 
+static void
+dummynet_fine(void *arg)
+{
+
+	(void)arg;	/* UNUSED */
+	/* with dn_fine_mtx held */
+	dn_fine_fired = dn_fine_at;
+	dn_fine_at = 0;
+	taskqueue_enqueue(dn_tq, &dn_fine_task);
+}
+
+/*
+ * Wake dummynet at key (us of uptime), unless it is already woken by then
+ * or releases go by the tick. The unlocked look is only a shortcut: a
+ * wakeup it misses waits for the tick, which serves the heap as well.
+ */
+void
+dn_fine_arm(uint64_t key)
+{
+
+	if (dn_gone != 0 || dn_release() >= tick)
+		return;
+	if (dn_fine_at != 0 && dn_fine_at <= key)
+		return;
+	mtx_lock_spin(&dn_fine_mtx);
+	if (dn_fine_at == 0 || key < dn_fine_at) {
+		dn_fine_at = key;
+		callout_reset_sbt(&dn_fine, ustosbt(key), 0, dummynet_fine,
+		    NULL, C_ABSOLUTE | C_DIRECT_EXEC);
+	}
+	mtx_unlock_spin(&dn_fine_mtx);
+}
+
