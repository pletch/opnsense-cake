-			} else { /* extracted a delay line */
-				transmit_event(&q, (struct delay_line *)p, V_dn_cfg.curr_time);
-			}
-		}
+		dn_serve_heap(&q, dn_now_us());
 		if (V_dn_cfg.expire && ++V_dn_cfg.expire_cycle >= V_dn_cfg.expire) {
 			V_dn_cfg.expire_cycle = 0;
 			dn_drain_scheduler();
 			dn_drain_queue();
 		}
+		dn_arm_top();
 		DN_BH_WUNLOCK();
 		if (q.head != NULL)
 			dummynet_send(q.head);
@@ -790,6 +852,51 @@ dummynet_task(void *context, int pending)
 	dn_reschedule();
 }
 
+/*
+ * A release between ticks (dn_fine_arm()): serve the events due by now,
+ * and wake again for the next one.
+ */
+void
+dummynet_fine_task(void *context, int pending)
+{
+	struct mq q;
+	struct epoch_tracker et;
+	uint64_t now, late;
+
+	VNET_ITERATOR_DECL(vnet_iter);
+	VNET_LIST_RLOCK();
+	NET_EPOCH_ENTER(et);
+
+	VNET_FOREACH(vnet_iter) {
+		memset(&q, 0, sizeof(struct mq));
+		CURVNET_SET(vnet_iter);
+		if (! V_dn_cfg.init_done) {
+			CURVNET_RESTORE();
+			continue;
+		}
+		DN_BH_WLOCK();
+		now = dn_now_us();
+		dn_serve_heap(&q, now);
+		if (q.count > 0) {
+			late = now > dn_fine_fired ? now - dn_fine_fired : 0;
+			dn_rel_wakeups++;
+			dn_rel_pkts += q.count;
+			dn_rel_late_sum += late;
+			if (late > dn_rel_late_max)
+				dn_rel_late_max = late;
+			if (late > (uint64_t)dn_release())
+				dn_rel_catchups++;
+		}
+		dn_arm_top();
+		DN_BH_WUNLOCK();
+		if (q.head != NULL)
+			dummynet_send(q.head);
+		CURVNET_RESTORE();
+	}
+	NET_EPOCH_EXIT(et);
+	VNET_LIST_RUNLOCK();
+}
+
