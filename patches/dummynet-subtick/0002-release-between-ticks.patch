-	/* Scale burst size: bytes -> bits * hz */
-	p->burst *= 8 * hz;
+	p->delay *= 1000;
+	/* Scale burst size: bytes -> bits * DN_CREDIT_HZ */
+	p->burst *= 8 * DN_CREDIT_HZ;
 
 	DN_BH_WLOCK();
 	/* do it twice, base link and FIFO link */
@@ -2585,6 +2630,9 @@ ip_dn_init(void)
 
 	dn_tasks_started = 1;
 	TASK_INIT(&dn_task, 0, dummynet_task, NULL);
+	TASK_INIT(&dn_fine_task, 0, dummynet_fine_task, NULL);
+	mtx_init(&dn_fine_mtx, "dn_fine", NULL, MTX_SPIN);
+	callout_init_mtx(&dn_fine, &dn_fine_mtx, 0);
 	dn_tq = taskqueue_create_fast("dummynet", M_WAITOK,
 	    taskqueue_thread_enqueue, &dn_tq);
 	taskqueue_start_threads(&dn_tq, 1, PI_NET, "dummynet");
@@ -2608,8 +2656,11 @@ ip_dn_destroy(int last)
 	}
 
 	callout_drain(&dn_timeout);
+	callout_drain(&dn_fine);
 	taskqueue_drain(dn_tq, &dn_task);
+	taskqueue_drain(dn_tq, &dn_fine_task);
 	taskqueue_free(dn_tq);
+	mtx_destroy(&dn_fine_mtx);
 }
 
 static int
