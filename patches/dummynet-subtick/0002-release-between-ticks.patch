 /*
  * Sub-tick release (opnsense-cake, SUBTICK.md): the longest a pipe's
- * packets wait to be released once they are due, in us. This dummynet
- * still releases once per tick, so the only value is the tick.
+ * packets wait to be released once they are due, in us, from
+ * DN_RELEASE_MIN to the tick (and 0, or the tick or more: the tick).
  */
+#define DN_RELEASE_MIN	10
+int dn_release_us;
+static int dn_catchup_us;	/* cap on the credit after a late wakeup */
+static u_long dn_rel_wakeups, dn_rel_pkts, dn_rel_late_sum, dn_rel_late_max;
+static u_long dn_rel_catchups;
+
 static int
 sysctl_release_us(SYSCTL_HANDLER_ARGS)
 {
 	int error, value;
 
-	value = tick;
+	value = dn_release();
 	error = sysctl_handle_int(oidp, &value, 0, req);
 	if (error != 0 || req->newptr == NULL)
 		return (error);
-	return (value == tick ? 0 : EINVAL);
+	if (value < 0 || (value > 0 && value < DN_RELEASE_MIN))
+		return (EINVAL);
+	dn_release_us = value >= tick ? 0 : value;
+	return (0);
 }
 
