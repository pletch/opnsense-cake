+    <field>
+        <id>pipe.cake_diffserv</id>
+        <label>CAKE diffserv</label>
+        <type>dropdown</type>
+        <advanced>true</advanced>
+        <help><![CDATA[How CAKE sorts packets into priority tins by DSCP. Each tin may use its share of the pipe bandwidth at priority.
+        <li>Best effort: one tin, no prioritization.</li>
+        <li>diffserv3 (default): Bulk (CS1, LE; 1/16), Best Effort and Voice (EF, VA, CS6, CS7; 1/4).</li>
+        <li>diffserv4: Bulk, Best Effort, Video (AF2x-AF4x, CS2, CS3; 1/2) and Voice (EF, VA, CS4-CS7; 1/4).</li>
+        ]]></help>
+        <grid_view>
+            <visible>false</visible>
+        </grid_view>
+    </field>
+    <field>
+        <id>pipe.cake_isolation</id>
+        <label>CAKE isolation</label>
+        <type>dropdown</type>
+        <advanced>true</advanced>
+        <help><![CDATA[How CAKE shares bandwidth between hosts and flows.
+        <li>Triple isolate (default): fair between source hosts and between destination hosts, then between each host's flows. Works on both upload and download pipes.</li>
+        <li>Per source / destination host, then flow: the same for one side only, e.g. source for an upload pipe, destination for a download pipe.</li>
+        <li>Per flow: fair between connections, so a host with many connections gets more.</li>
+        ]]></help>
+        <grid_view>
+            <visible>false</visible>
+        </grid_view>
+    </field>
+    <field>
+        <id>pipe.cake_link</id>
+        <label>CAKE link type</label>
+        <type>dropdown</type>
+        <advanced>true</advanced>
+        <help>Link-layer overhead of the bottleneck link. CAKE then charges each packet for what it takes on that link, so the bandwidth can be set close to the line or sync rate instead of well below it.</help>
+        <grid_view>
+            <visible>false</visible>
+        </grid_view>
+    </field>
+    <field>
+        <id>pipe.cake_overhead</id>
+        <label>CAKE overhead</label>
+        <type>text</type>
+        <advanced>true</advanced>
+        <help>Bytes added to each packet on the link (-64 to 256), overriding the link type. E.g. add 4 for a VLAN tag.</help>
+        <grid_view>
+            <visible>false</visible>
+        </grid_view>
+    </field>
+    <field>
+        <id>pipe.cake_mpu</id>
+        <label>CAKE MPU</label>
+        <type>text</type>
+        <advanced>true</advanced>
+        <help>Minimum packet size on the link in bytes, overriding the link type.</help>
+        <grid_view>
+            <visible>false</visible>
+        </grid_view>
+    </field>
+    <field>
+        <id>pipe.cake_framing</id>
+        <label>CAKE framing</label>
+        <type>dropdown</type>
+        <advanced>true</advanced>
+        <help>Link framing, overriding the link type: ATM cells for ADSL, PTM for VDSL2.</help>
         <grid_view>
             <visible>false</visible>
         </grid_view>
diff --git a/src/opnsense/mvc/app/models/OPNsense/TrafficShaper/TrafficShaper.php b/src/opnsense/mvc/app/models/OPNsense/TrafficShaper/TrafficShaper.php
