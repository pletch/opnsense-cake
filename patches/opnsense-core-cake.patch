                     }
                 }
+                if (
+                    in_array($node->getInternalXMLTagName(), ['scheduler', 'fqcodel_quantum']) &&
+                    $parentNode->scheduler == 'cake' && !$parentNode->fqcodel_quantum->isEmpty() &&
+                    $parentNode->fqcodel_quantum->asInt() < 300
+                ) {
+                    $messages->appendMessage(new Message(
+                        gettext('The CAKE quantum must be at least 300 bytes.'),
+                        $parentNode->fqcodel_quantum->__reference
+                    ));
+                }
             }
         }
         return $messages;
